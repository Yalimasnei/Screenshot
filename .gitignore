# Only program source, build scripts, resources and documentation are tracked.
/*
!/.gitignore
!/LICENSE
!/README.md
!/src/
!/scripts/
!/resources/
!/docs/
!/third_party/

/src/**
!/src/**/
!/src/**/*.cpp
!/src/**/*.h

/scripts/**
!/scripts/**/*.ps1

/resources/**
!/resources/**/*.rc
!/resources/**/*.manifest

/docs/**
!/docs/**/*.md

/third_party/**
!/third_party/nv-codec-headers/
!/third_party/nv-codec-headers/nvEncodeAPI.h
